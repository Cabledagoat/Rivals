local function rayParams(camera)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local ignore = {camera}
    if player.Character then table.insert(ignore, player.Character) end
    params.FilterDescendantsInstances = ignore
    return params
end
local function visible(camera, params, character, point)
    local origin = camera.CFrame.Position
    local hit = Workspace:Raycast(origin, point - origin, params)
    return hit == nil or hit.Instance:IsDescendantOf(character)
end
local function lookAt(from, to, preferredUp)
    local delta = to - from
    if delta.Magnitude < 0.001 then return nil end
    local direction = delta.Unit
    local reference = preferredUp or Vector3.new(0, 1, 0)
    local up = reference - direction * reference:Dot(direction)
    if up.Magnitude < 0.001 then
        reference = math.abs(direction.Z) < 0.9 and Vector3.new(0, 0, 1) or Vector3.new(1, 0, 0)
        up = reference - direction * reference:Dot(direction)
    end
    return CFrame.lookAt(from, to, up.Unit)
end
local function overWindow()
    local mouse = UIS:GetMouseLocation()
    local function contains(control)
        if not control.Visible then return false end
        local pos, size = control.AbsolutePosition, control.AbsoluteSize
        return mouse.X >= pos.X and mouse.Y >= pos.Y
            and mouse.X <= pos.X + size.X and mouse.Y <= pos.Y + size.Y
    end
    -- Synthetic firing must not click either the menu or its launcher.
    return contains(window) or contains(launcher)
end
local function fire(now)
    if menuOpen or GuiService.MenuIsOpen or not focused or drag or UIS:GetFocusedTextBox() or overWindow() then return end
    if now - lastShot < Config.ShotInterval then return end
    lastShot = now
    if click then
        local ok = pcall(click)
        if ok then fireIssue = nil; return end
        click = nil
    end
    local tool = player.Character and player.Character:FindFirstChildOfClass("Tool")
    if tool and pcall(function() tool:Activate() end) then
        fireIssue = nil
        task.delay(0.03, function() if tool.Parent then pcall(function() tool:Deactivate() end) end end)
    else fireIssue = "No working fire input" end
end

-- BEGIN AIM LOCK LOGIC
local function chooseAimTarget(candidates, now, enabled)
    if not enabled then aimLock = nil; return nil, "Aim idle" end
    if aimLock then
        local retained
        for _, candidate in ipairs(candidates) do
            if candidate.player == aimLock.player and candidate.character == aimLock.character then retained = candidate; break end
        end
        if retained then
            local clear = not Config.VisibleOnly or retained.seen
            -- Screen projection uses the game's uncorrected camera. It must not
            -- invalidate a held lock when that camera resets/recoils before us.
            if clear then
                aimLock.invalidSince = nil
                return retained, "Locked: " .. retained.player.DisplayName
            end
            aimLock.invalidSince = aimLock.invalidSince or now
            if now - aimLock.invalidSince < Config.LockGrace then
                return nil, "Target blocked; holding last view"
            end
        end
        aimLock = nil
    end
    local selected
    local bestDistance = Config.FOV
    for _, candidate in ipairs(candidates) do
        if candidate.onScreen and candidate.distance <= bestDistance and (not Config.VisibleOnly or candidate.seen) then
            selected, bestDistance = candidate, candidate.distance
        end
    end
    if selected then
        aimLock = {player = selected.player, character = selected.character}
        return selected, "Locked: " .. selected.player.DisplayName
    end
    return nil, "No eligible target in FOV"
end
-- END AIM LOCK LOGIC

-- BEGIN AIM TRACKING LOGIC
local function updateAimTracking(selected, dt)
    local rawOffset = selected.head.Position - selected.root.Position
    if not aimTrack or aimTrack.player ~= selected.player
        or aimTrack.character ~= selected.character or aimTrack.head ~= selected.head then
        aimTrack = {player = selected.player, character = selected.character,
            head = selected.head, offset = rawOffset, rotation = nil}
    else
        local damping = math.max(Config.TrackingDamping, 0)
        local alpha = damping == 0 and 1 or (1 - math.exp(-math.max(dt, 0) / damping))
        aimTrack.offset = aimTrack.offset:Lerp(rawOffset, alpha)
    end
    -- Follow the root immediately; only the animated head offset is damped.
    return selected.root.Position + aimTrack.offset
end
-- END AIM TRACKING LOGIC

local edges = {
    {"Head", "UpperTorso"}, {"UpperTorso", "LowerTorso"},
    {"UpperTorso", "LeftUpperArm"}, {"LeftUpperArm", "LeftLowerArm"}, {"LeftLowerArm", "LeftHand"},
    {"UpperTorso", "RightUpperArm"}, {"RightUpperArm", "RightLowerArm"}, {"RightLowerArm", "RightHand"},
    {"LowerTorso", "LeftUpperLeg"}, {"LeftUpperLeg", "LeftLowerLeg"}, {"LeftLowerLeg", "LeftFoot"},
    {"LowerTorso", "RightUpperLeg"}, {"RightUpperLeg", "RightLowerLeg"}, {"RightLowerLeg", "RightFoot"},
    {"Head", "Torso"}, {"Torso", "Left Arm"}, {"Torso", "Right Arm"}, {"Torso", "Left Leg"}, {"Torso", "Right Leg"},
}
local function createVisual(p)
    local frame = make("Frame", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1}, overlay)
    local box = make("Frame", {BackgroundTransparency = 1, Visible = false}, frame)
    local stroke = make("UIStroke", {Color = green, Thickness = 1.5}, box)
    local health = make("TextLabel", {BackgroundTransparency = 1, Font = Enum.Font.Code,
        TextSize = 13, TextColor3 = white, TextStrokeTransparency = 0.3, Visible = false}, frame)
    local highlight = make("Highlight", {Enabled = false, DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
        FillTransparency = 0.6, OutlineTransparency = 0}, gui)
    local lines = {}
    for i = 1, #edges do
        lines[i] = make("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), BorderSizePixel = 0,
            BackgroundColor3 = green, Visible = false}, frame)
    end
    local v = {frame = frame, box = box, stroke = stroke, health = health, highlight = highlight, lines = lines}
    visuals[p] = v
    return v
end
local function bounds(camera, character)
    local minX, minY, maxX, maxY = math.huge, math.huge, -math.huge, -math.huge
    for _, part in ipairs(character:GetChildren()) do
        if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
            for x = -1, 1, 2 do for y = -1, 1, 2 do for z = -1, 1, 2 do
                local point = camera:WorldToViewportPoint(part.CFrame:PointToWorldSpace(part.Size * Vector3.new(x, y, z) * 0.5))
                if point.Z <= 0.1 then return nil end
                minX, minY = math.min(minX, point.X), math.min(minY, point.Y)
                maxX, maxY = math.max(maxX, point.X), math.max(maxY, point.Y)
            end end end
        end
    end
    local size = camera.ViewportSize
    if minX == math.huge or maxX < 0 or maxY < 0 or minX > size.X or minY > size.Y then return nil end
    return minX, minY, maxX - minX, maxY - minY
end
local function updateVisual(p, character, humanoid, color, camera)
    local v = visuals[p] or createVisual(p)
    v.frame.Visible = true
    v.highlight.Adornee, v.highlight.Enabled = character, Config.Highlight
    v.highlight.FillColor, v.highlight.OutlineColor = color, color
    v.box.Visible, v.health.Visible = false, false
    if Config.Box or Config.Health then
        local x, y, w, h = bounds(camera, character)
        if x then
            v.box.Position, v.box.Size = UDim2.fromOffset(x, y), UDim2.fromOffset(w, h)
            v.stroke.Color, v.box.Visible = color, Config.Box
            v.health.Position, v.health.Size = UDim2.fromOffset(x - 40, y - 20), UDim2.fromOffset(w + 80, 18)
            v.health.Text = string.format("%s %d/%d HP", p.DisplayName, math.ceil(humanoid.Health), math.ceil(humanoid.MaxHealth))
            v.health.TextColor3, v.health.Visible = color, Config.Health
        end
    end
    for i, edge in ipairs(edges) do
        local line = v.lines[i]
        line.Visible = false
        if Config.Skeleton then
            local a, b = character:FindFirstChild(edge[1]), character:FindFirstChild(edge[2])
            if a and b and a:IsA("BasePart") and b:IsA("BasePart") then
                local pa, onA = camera:WorldToViewportPoint(a.Position)
                local pb, onB = camera:WorldToViewportPoint(b.Position)
                if onA and onB and pa.Z > 0.1 and pb.Z > 0.1 then
                    local start, finish = Vector2.new(pa.X, pa.Y), Vector2.new(pb.X, pb.Y)
                    local delta, mid = finish - start, (start + finish) * 0.5
                    line.Position, line.Size = UDim2.fromOffset(mid.X, mid.Y), UDim2.fromOffset(delta.Magnitude, 1.5)
                    line.Rotation = math.deg(math.atan2(delta.Y, delta.X))
                    line.BackgroundColor3, line.Visible = color, true
                end
            end
        end
    end
end
local function renderESP(camera, params)
    for _, v in pairs(visuals) do v.frame.Visible = false; v.highlight.Enabled = false end
    if not (Config.Box or Config.Health or Config.Highlight or Config.Skeleton) then return end
    for _, p in ipairs(getTargets()) do
        if enemy(p) then
            local character, humanoid, _, head = alive(p)
            if character and (head.Position - camera.CFrame.Position).Magnitude <= Config.MaxDistance then
                updateVisual(p, character, humanoid, visible(camera, params, character, head.Position) and green or red, camera)
            end
        end
    end
end
local function updateTrigger(camera, params, now)
    if not Config.Trigger then triggerTarget = nil; return end
    local center = camera.ViewportSize * 0.5
    local ray = camera:ViewportPointToRay(center.X, center.Y)
    local hit = Workspace:Raycast(ray.Origin, ray.Direction * Config.MaxDistance, params)
    local target
    if hit then
        for _, p in ipairs(getTargets()) do
            local character = enemy(p) and alive(p)
            if character and hit.Instance:IsDescendantOf(character) and not character:FindFirstChildOfClass("ForceField") then
                target = p; break
            end
        end
    end
    if not target then triggerTarget = nil; return end
    if target ~= triggerTarget then triggerTarget, triggerSince = target, now end
    if now - triggerSince >= Config.TriggerDelay then fire(now) end
end
local function updateCombat(camera, params, dt)
    local myCharacter, _, myRoot, myHead = alive(player)
    if menuOpen or GuiService.MenuIsOpen or not focused or drag or UIS:GetFocusedTextBox() or not myCharacter then
        resetCombat()
        if GuiService.MenuIsOpen then return "Paused: Roblox menu open" end
        if menuOpen then return "SETTINGS: click PLAY to enable combat helpers" end
        if not focused then return "Paused: window not focused" end
        if not myCharacter then return "Waiting for a live standard character" end
        if drag then return "Paused: moving controls" end
        return "Paused: typing"
    end
    if not combatViewAllowed(camera, myHead) then
        resetCombat()
        if Config.NPCOnly then return "NPC aim paused: turn OFF first-person-only for third-person games" end
        return "Combat paused: third-person camera"
    end
    local pressed = UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
    if not pressed then aimReady = true end
    local aimHeld = Config.Aim and aimReady and pressed
    local now, center = os.clock(), camera.ViewportSize * 0.5
    local candidates, rageTarget, bestRage = {}, nil, math.huge
    if aimHeld or Config.Rage then
        for _, p in ipairs(getTargets()) do
            if enemy(p) then
                local character, _, root, head = alive(p)
                if character and not character:FindFirstChildOfClass("ForceField")
                    and (head.Position - camera.CFrame.Position).Magnitude <= Config.MaxDistance then
                    local point, onScreen = camera:WorldToViewportPoint(head.Position)
                    local candidate = {player = p, character = character, head = head, root = root,
                        onScreen = onScreen and point.Z > 0,
                        distance = (Vector2.new(point.X, point.Y) - center).Magnitude,
                        seen = not Config.VisibleOnly or visible(camera, params, character, head.Position)}
                    table.insert(candidates, candidate)
                    local distance = (root.Position - myRoot.Position).Magnitude
                    if distance < bestRage then bestRage, rageTarget = distance, candidate end
                end
            end
        end
    end
    if Config.Rage then
        aimLock, aimTrack, triggerTarget = nil, nil, nil
        if not rageTarget then return "Rage: no eligible target" end
        local pose = lookAt(rageTarget.root.Position + Vector3.new(0, Config.RageHeight, 0), rageTarget.head.Position)
        if pose then
            myRoot.CFrame, myRoot.AssemblyLinearVelocity = pose, Vector3.zero
            local view = lookAt(camera.CFrame.Position, rageTarget.head.Position, camera.CFrame.UpVector)
            if view then camera.CFrame = view end
            if visible(camera, params, rageTarget.character, rageTarget.head.Position) then fire(now) end
        end
        return "Rage active (overrides normal aim)"
    end
    local selected, reason = chooseAimTarget(candidates, now, aimHeld)
    if Config.NPCOnly and aimHeld and not selected and not aimLock then
        if #candidates == 0 then
            reason = "No eligible NPCs: check scan, range, or ForceField"
        else
            local inFOV = false
            for _, candidate in ipairs(candidates) do
                if candidate.onScreen and candidate.distance <= Config.FOV then inFOV = true; break end
            end
            reason = inFOV and "NPCs in FOV blocked by visibility check" or "NPCs found, but outside FOV"
        end
    end
    if not Config.Aim then reason = "Aimbot OFF: RightShift to enable"
    elseif not aimReady then reason = "Release RMB, then press and hold it"
    elseif not aimHeld then reason = "Aimbot ready: hold RMB" end
    if selected then
        local aimPoint = updateAimTracking(selected, dt)
        -- Use world-up for normal aim, rather than importing game camera roll.
        local target = lookAt(camera.CFrame.Position, aimPoint)
        if target then
            local strength = math.clamp(Config.AimStrength, 1, 450)
            if strength >= 450 or Config.Smoothing <= 0 then camera.CFrame = target
            else
                -- Continue our previous orientation even if the game rewrites
                -- its camera before this callback. Keep the current position.
                local start = aimTrack.rotation and CFrame.new(camera.CFrame.Position) * aimTrack.rotation or camera.CFrame
                camera.CFrame = start:Lerp(target, 1 - math.exp(-dt * (strength / 100) / Config.Smoothing))
            end
            aimTrack.rotation = camera.CFrame.Rotation
        end
    elseif aimHeld and aimLock and aimTrack and aimTrack.rotation then
        -- Brief occlusion: hold orientation without following the hidden target.
        -- This prevents a return to the raw camera and snap-back on the next frame.
        camera.CFrame = CFrame.new(camera.CFrame.Position) * aimTrack.rotation
    else
        aimTrack = nil
    end
    updateTrigger(camera, params, now)
    return reason
end

local lastCamera, lastError = nil, -math.huge
local nextNPCSummary = 0
local function frame(dt)
    syncFullbright(Config.Fullbright)
    local camera = Workspace.CurrentCamera
    if camera ~= lastCamera then
        -- Scope/camera replacements need a new blend origin, not a fresh RMB press.
        if aimTrack then aimTrack.rotation = nil end
        triggerTarget = nil
        lastCamera = camera
    end
    if not camera then api.Status = "Waiting for camera"; return end
    resizeWindow()
    local center = camera.ViewportSize * 0.5
    circle.Position, circle.Size = UDim2.fromOffset(center.X, center.Y), UDim2.fromOffset(Config.FOV * 2, Config.FOV * 2)
    circle.Visible = Config.ShowFOV
    local params = rayParams(camera)
    api.Status = updateCombat(camera, params, dt)
    -- Keep the last actual aim attempt after RMB release so opening settings
    -- doesn't replace the useful failure reason with "hold RMB" or "paused".
    if not menuOpen and (Config.Rage or not Config.Aim
        or UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)) then
        lastGameplayStatus = api.Status
    end
    if menuOpen and Config.NPCOnly and os.clock() >= nextNPCSummary then
        getTargets()
        nextNPCSummary = os.clock() + 0.5
    end
    status.Text = (menuOpen and "Settings paused\nLast: " .. lastGameplayStatus or api.Status)
        .. (Config.NPCOnly and "\n" .. npcSummary or "") .. (fireIssue and "\n" .. fireIssue or "")
    renderESP(camera, params)
end
