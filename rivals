local function alive(p)
    local character = p.Character
    if not character then return end
    local isNPC = type(p) == "table" and p.IsNPC
    local humanoid = isNPC and p.Humanoid or character:FindFirstChildOfClass("Humanoid")
    if humanoid and not humanoid:IsDescendantOf(character) then return end
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local head = character and character:FindFirstChild("Head")
    if isNPC and humanoid then
        local function validPart(part)
            return part and part:IsA("BasePart") and part:IsDescendantOf(character) and part or nil
        end
        local function namedPart(name)
            local found = character:FindFirstChild(name, true)
            if not found then return nil end
            return validPart(found) or validPart(found:FindFirstChildWhichIsA("BasePart", true))
        end
        root = validPart(humanoid.RootPart) or validPart(character.PrimaryPart)
            or namedPart("HumanoidRootPart") or namedPart("Torso") or namedPart("UpperTorso")
            or namedPart("Root") or namedPart("Body")
            or validPart(character:FindFirstChildWhichIsA("BasePart", true))
        head = namedPart("Head") or root
    end
    if humanoid and humanoid.Health > 0 and root and root:IsA("BasePart") and head and head:IsA("BasePart") then
        return character, humanoid, root, head
    end
end
