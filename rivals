RunService:BindToRenderStep(bindName, Enum.RenderPriority.Last.Value + 1, function(dt)
    if not active then return end
    local ok, err = pcall(frame, dt)
    -- A cursor error cannot escape this callback or block the stop key's cleanup.
    local cursorOK, cursorError = pcall(syncCursor)
    if not ok or not cursorOK then
        resetCombat()
        api.Status = "Error: " .. tostring(not cursorOK and cursorError or err)
        status.Text = api.Status
        if os.clock() - lastError > 3 then lastError = os.clock(); warn(api.Status) end
    end
end)
