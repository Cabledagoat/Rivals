    launcher.Position = UDim2.fromOffset(
        math.clamp(x, 0, math.max(0, size.X - 64)),
        math.clamp(y, 0, math.max(0, size.Y - 64)))
end
local function resizeWindow()
    local size = viewport()
    window.Size = UDim2.fromOffset(math.min(300, math.max(160, size.X - 20)),
        minimized and 34 or math.min(624, math.max(72, size.Y - 40)))
    moveWindow(window.Position.X.Offset, window.Position.Y.Offset)
    if launcherMoved then moveLauncher(launcher.Position.X.Offset, launcher.Position.Y.Offset) end
