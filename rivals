-- BEGIN TARGET SOURCE LOGIC
local npcRecords = {}
local playerCharacters = setmetatable({}, {__mode = "k"})
local npcIndexReady = false
local function npcModelAllowed(model)
    if not model or not model:IsDescendantOf(Workspace) then return false end
    local camera = Workspace.CurrentCamera
    if camera and model:IsDescendantOf(camera) then return false end
    local ancestor = model
    while ancestor and ancestor ~= Workspace do
        if playerCharacters[ancestor] then return false end
        ancestor = ancestor.Parent
    end
    return true
end
local function enemy(p)
    if type(p) == "table" and p.IsNPC then
        return Config.NPCOnly and npcModelAllowed(p.Character)
    end
    if Config.NPCOnly then return false end
    return p ~= player and not (Config.TeamCheck and player.Team ~= nil and p.Team == player.Team)
end
local function registerNPC(instance)
    if not instance:IsA("Humanoid") then return end
    local model = instance:FindFirstAncestorOfClass("Model")
    if not model then return end
    local record = npcRecords[model]
    if not record then
        record = {IsNPC = true, Character = model, DisplayName = model.Name}
        npcRecords[model] = record
    end
    record.Humanoid = instance
end
local function ensureNPCIndex()
    if npcIndexReady then return end
    npcIndexReady = true
    local function trackPlayer(p)
        local function mark(character)
            playerCharacters[character] = true
            local record = npcRecords[character]
            if record then destroyVisual(record) end
        end
        if p.Character then mark(p.Character) end
        connect(p.CharacterAdded, mark)
    end
    for _, p in ipairs(Players:GetPlayers()) do trackPlayer(p) end
    connect(Players.PlayerAdded, trackPlayer)
    connect(Workspace.DescendantAdded, registerNPC)
    connect(Workspace.DescendantRemoving, function(instance)
        local humanoidRemoved = instance:IsA("Humanoid")
        local model = humanoidRemoved and instance:FindFirstAncestorOfClass("Model") or instance
        local record = npcRecords[model]
        if record and (not humanoidRemoved or record.Humanoid == instance) then
            destroyVisual(record); npcRecords[model] = nil
        end
    end)
    -- One initial scan; subsequent NPC spawns/removals use events.
    for _, instance in ipairs(Workspace:GetDescendants()) do registerNPC(instance) end
end
local function getTargets()
    if not Config.NPCOnly then return Players:GetPlayers() end
    ensureNPCIndex()
    -- Refresh current ownership as well as remembering past player characters.
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character then playerCharacters[p.Character] = true end
    end
    local targets, incomplete, dead = {}, 0, 0
    for model, record in pairs(npcRecords) do
        if npcModelAllowed(model) then
            local character, humanoid = alive(record)
            if character then
                record.DisplayName = humanoid.DisplayName ~= "" and humanoid.DisplayName or model.Name
                table.insert(targets, record)
            elseif record.Humanoid and record.Humanoid.Health <= 0 then
                dead = dead + 1
            else
                incomplete = incomplete + 1
            end
        end
    end
    npcSummary = string.format("NPCs: %d ready, %d incomplete, %d dead", #targets, incomplete, dead)
    return targets
end
refreshNPCs = function()
    if not npcIndexReady then ensureNPCIndex()
    else
        for model, record in pairs(npcRecords) do
            if not model:IsDescendantOf(Workspace) or not record.Humanoid
                or not record.Humanoid:IsDescendantOf(model) then
                destroyVisual(record)
                npcRecords[model] = nil
            end
        end
        for _, instance in ipairs(Workspace:GetDescendants()) do registerNPC(instance) end
    end
    if Config.NPCOnly then getTargets() end
end
