local cleanupComplete = false
local function unload()
    if cleanupComplete then return end
    active = false
    local allClean = true
    local function attempt(label, fn)
        local ok, err = pcall(fn)
        if not ok then
            allClean = false
            warn("Client test cleanup (" .. label .. "): " .. tostring(err))
        end
    end
    -- Each step runs even if another one fails. Failed cleanup remains retryable.
    attempt("render binding", function() RunService:UnbindFromRenderStep(bindName) end)
    for _, conn in ipairs(connections) do attempt("connection", function() conn:Disconnect() end) end
    attempt("modal", function() title.Modal = false end)
    attempt("lighting", function() syncFullbright(false) end)
    attempt("cursor", function() updateCursor(false) end)
    attempt("drag", stopDrag)
    resetCombat()
    for p in pairs(visuals) do attempt("ESP", function() destroyVisual(p) end) end
    attempt("GUI", function() gui:Destroy() end)
    cleanupComplete = allClean
    if allClean and env.PrivateClientTest and env.PrivateClientTest.Unload == unload then env.PrivateClientTest = nil end
end
