-- BEGIN FULLBRIGHT LOGIC
local savedLighting
local brightLighting = {
    Brightness = 2, ClockTime = 14, GlobalShadows = false, ExposureCompensation = 0,
    Ambient = Color3.fromRGB(255, 255, 255), OutdoorAmbient = Color3.fromRGB(255, 255, 255),
}
local function syncFullbright(enabled)
    if enabled then
        if not savedLighting then
            savedLighting = {}
            for property in pairs(brightLighting) do savedLighting[property] = Lighting[property] end
        end
        for property, value in pairs(brightLighting) do
            if Lighting[property] ~= value then Lighting[property] = value end
        end
    elseif savedLighting then
        local failure
        for property, value in pairs(savedLighting) do
            local ok, err = pcall(function() Lighting[property] = value end)
            if ok then savedLighting[property] = nil else failure = err end
        end
        if next(savedLighting) == nil then savedLighting = nil end
        if failure then error("Lighting restore failed: " .. tostring(failure)) end
    end
end
-- END FULLBRIGHT LOGIC

-- BEGIN CURSOR LOGIC
local function updateCursor(wanted)
    if wanted then
        if not cursorSaved then
            cursorSaved = {
                behavior = UIS.MouseBehavior,
                enabled = UIS.MouseIconEnabled,
                icon = UIS.MouseIcon,
            }
        end
        UIS.MouseBehavior = Enum.MouseBehavior.Default
        UIS.MouseIconEnabled = true
        UIS.MouseIcon = ""
    elseif cursorSaved then
        local saved = cursorSaved
        local behaviorOK, behaviorError = pcall(function() UIS.MouseBehavior = saved.behavior end)
        local enabledOK, enabledError = pcall(function() UIS.MouseIconEnabled = saved.enabled end)
        local iconOK, iconError = pcall(function() UIS.MouseIcon = saved.icon end)
        if behaviorOK and enabledOK and iconOK then
            cursorSaved = nil
        else
            error("Cursor restore failed: " .. tostring(behaviorError or enabledError or iconError))
        end
    end
end
-- END CURSOR LOGIC

